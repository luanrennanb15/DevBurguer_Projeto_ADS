# ============================================================
# MODELO de configuração da API DevBurguer (PostgreSQL).
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA coloque senha de verdade aqui (este arquivo vai pro Git).
# ============================================================

# Porta da API. Em nuvem, o provedor costuma injetar a porta automaticamente.
PORT=3001

# ── Banco de dados (PostgreSQL) ─────────────────────────────
# Pegue esses valores na "connection string" do seu provedor
# (Supabase: Project Settings > Database; Neon: dashboard do projeto).
DB_SERVER=seu_host.postgres.exemplo.com
DB_DATABASE=devburguer
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_aqui
DB_PORT=5432

# Serviços gerenciados (Supabase, Neon...) exigem SSL -> deixe true.
# Em Postgres local, use false.
DB_SSL=true

# ── Segurança / CORS ────────────────────────────────────────
# Domínio(s) do site autorizados a chamar a API (separe por vírgula).
# Use "*" apenas em desenvolvimento; em produção coloque a URL do site.
CORS_ORIGIN=*
