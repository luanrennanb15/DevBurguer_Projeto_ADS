# ============================================================
# MODELO de configuração da API DevBurguer.
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA coloque senha de verdade aqui (este arquivo vai pro Git).
# ============================================================

# Porta da API. Em nuvem, o provedor costuma injetar a porta automaticamente.
PORT=3001

# ── Banco de dados (SQL Server) ─────────────────────────────
# Local: DB_SERVER = nome do PC (ex.: DESKTOP-XXXX)
# Nuvem: DB_SERVER = host do banco gerenciado (ex.: xxx.database.windows.net)
DB_SERVER=seu_servidor_aqui
DB_DATABASE=DevBurguerDB
DB_USER=seu_usuario_sql
DB_PASSWORD=sua_senha_aqui
DB_PORT=1433

# true em nuvem (Azure SQL exige conexão criptografada); false em SQL local
DB_ENCRYPT=false
# true só em servidor local sem certificado válido; false em nuvem
DB_TRUST_CERT=true

# ── Segurança / CORS ────────────────────────────────────────
# Domínio(s) do site autorizados a chamar a API (separe por vírgula).
# Use "*" apenas em desenvolvimento; em produção coloque a URL do site.
CORS_ORIGIN=*
