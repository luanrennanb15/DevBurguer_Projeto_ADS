<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fundo_cartao"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txvItemCarrinhoNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/corBranca"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txvItemCarrinhoPreco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/corBranca"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lytItemCarrinhoAdicionais"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txvItemCarrinhoAdicionais"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/corTextoSecundario"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnItemCarrinhoAdicionais"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/fundo_botao_quadrado_contorno"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/botaoAdicionais"
            android:textAllCaps="false"
            android:textColor="@color/corDourada"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtItemCarrinhoObservacao"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/fundo_campo_texto"
            android:hint="@string/dicaObservacaoItem"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/corBranca"
            android:textColorHint="@color/corTextoSecundario"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnItemCarrinhoRemover"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/fundo_botao_quadrado_contorno"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/simboloMenos"
                android:textColor="@color/corBranca"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txvItemCarrinhoQuantidade"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/corBranca"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnItemCarrinhoAdicionar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/fundo_botao_quadrado_vermelho"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/simboloMais"
                android:textColor="@color/corBranca"
                android:textSize="20sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
