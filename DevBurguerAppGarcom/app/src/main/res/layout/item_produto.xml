<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/corFundoPrincipal"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txvItemProdutoNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/corBranca"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txvItemProdutoDescricao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/corTextoSecundario"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txvItemProdutoPreco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/corBranca"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp">

        <LinearLayout
            android:id="@+id/grpContadorProduto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnItemProdutoRemover"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/fundo_botao_quadrado_contorno"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/simboloMenos"
                android:textColor="@color/corBranca"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txvItemProdutoQuantidade"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/corBranca"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnItemProdutoAdicionarMais"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/fundo_botao_quadrado_vermelho"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/simboloMais"
                android:textColor="@color/corBranca"
                android:textSize="20sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnItemProdutoAdicionar"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/fundo_chip_selecionado"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/botaoAdicionar"
            android:textColor="@color/corVermelhoPrincipal"
            android:textSize="15sp"
            android:textStyle="bold" />

    </FrameLayout>

</LinearLayout>
