<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/corFundoPrincipal"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txvTituloMesas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tituloTelaMesas"
                android:textColor="@color/corBranca"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txvSaudacaoGarcom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/corTextoSecundario"
                android:textSize="15sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSair"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/botaoSair"
            android:textAllCaps="false"
            android:textColor="@color/corBranca"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/lytCarregando"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/corVermelhoPrincipal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/carregandoMesas"
                android:textColor="@color/corTextoSecundario"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lytErro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txvMensagemErro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/corBranca"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnTentarNovamente"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/fundo_botao_pilula"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/botaoTentarNovamente"
                android:textColor="@color/corBranca"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lytConteudo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/fundo_mesa_livre" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="@string/legendaStatusLivre"
                    android:textColor="@color/corBranca"
                    android:textSize="13sp" />

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/fundo_mesa_ocupada" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/legendaStatusOcupada"
                    android:textColor="@color/corBranca"
                    android:textSize="13sp" />

            </LinearLayout>

            <GridView
                android:id="@+id/grdMesas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnWidth="100dp"
                android:horizontalSpacing="12dp"
                android:numColumns="auto_fit"
                android:stretchMode="columnWidth"
                android:verticalSpacing="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/avisoToqueMesa"
                android:textColor="@color/corTextoSecundario"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
