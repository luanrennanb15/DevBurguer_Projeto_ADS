<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/corFundoPrincipal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="28dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/fundo_circulo_vermelho">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_hamburguer" />

        </FrameLayout>

        <TextView
            android:id="@+id/txvTituloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tituloApp"
            android:textColor="@color/corBranca"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txvSubtituloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:text="@string/subtituloApp"
            android:textColor="@color/corTextoSecundario"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/dicaUsuario"
            android:textColor="@color/corBranca"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtUsuario"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/fundo_campo_texto"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/corBranca"
            android:textColorHint="@color/corTextoSecundario"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/dicaSenha"
            android:textColor="@color/corBranca"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtSenha"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/fundo_campo_texto"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/corBranca"
            android:textColorHint="@color/corTextoSecundario"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnEntrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/fundo_botao_pilula"
            android:text="@string/botaoEntrar"
            android:textColor="@color/corBranca"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/avisoCadastroGarcom"
            android:textColor="@color/corTextoSecundario"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
